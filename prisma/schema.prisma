generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Tanque {
  id           Int      @id @default(autoincrement())
  nombre       String
  tipo         String
  descripcion  String?
  imagen     String?
  creadoEn     DateTime @default(now())
  modificadoEn DateTime @updatedAt
  favoritos  Favorito[]
}

model Usuario {
  id           Int      @id @default(autoincrement())
  email        String   @unique
  password     String
  nombre       String
  rol          String   @default("user")
  refreshToken String?
  creadoEn     DateTime @default(now())
  modificadoEn DateTime @updatedAt
  favoritos  Favorito[]
}

model Favorito {
  id         Int      @id @default(autoincrement())
  usuarioId  Int
  tanqueId   Int
  creadoEn   DateTime @default(now())

  usuario    Usuario  @relation(fields: [usuarioId], references: [id])
  tanque     Tanque   @relation(fields: [tanqueId], references: [id])

  @@unique([usuarioId, tanqueId]) // evita duplicados
}